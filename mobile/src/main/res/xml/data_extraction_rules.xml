<?xml version="1.0" encoding="utf-8"?>
<!-- Settings travel with a backup; the live state of the devices (what the peer reported, the
     temporary Riposo mode, setup progress) is rebuilt on the new device instead -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="peer_info.xml" />
        <exclude domain="sharedpref" path="riposo.xml" />
        <exclude domain="sharedpref" path="setup.xml" />
        <exclude domain="file" path="diag.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="peer_info.xml" />
        <exclude domain="sharedpref" path="riposo.xml" />
        <exclude domain="sharedpref" path="setup.xml" />
        <exclude domain="file" path="diag.log" />
    </device-transfer>
</data-extraction-rules>
