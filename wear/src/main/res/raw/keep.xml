<?xml version="1.0" encoding="utf-8"?>
<!-- Resources read by name, never from code, that resource shrinking must keep:
     the Wear OS capability Google Play services advertises to the other device, and the licence
     texts shipped with the app -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities,@raw/license_*" />
